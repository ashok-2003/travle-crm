{
  "name": "@travel-crm/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "worker": "tsx --env-file-if-exists=../../.env src/worker.ts",
    "console": "tsx --env-file-if-exists=../../.env src/console.ts",
    "first-super-admin": "tsx --env-file-if-exists=../../.env src/console-command.ts first-super-admin",
    "demo": "tsx --env-file-if-exists=../../.env src/console-command.ts demo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@hono/trpc-server": "0.4.2",
    "@travel-crm/api": "workspace:*",
    "@travel-crm/brand": "workspace:*",
    "@travel-crm/contracts": "workspace:*",
    "@travel-crm/db": "workspace:*",
    "@travel-crm/domain": "workspace:*",
    "@travel-crm/integrations": "workspace:*",
    "@trpc/server": "11.19.0",
    "hono": "4.13.13",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-auth/utils": "0.4.2",
    "@travel-crm/eslint-config": "workspace:*",
    "@travel-crm/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "unpdf": "1.8.1",
    "vitest": "catalog:"
  }
