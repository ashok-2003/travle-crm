{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate": {
      "dependsOn": ["^generate", "@travel-crm/brand#build"],
      "inputs": [
        "scripts/**",
        "src/service-worker/**",
        "src/app/**/page.*",
        "src/lib/routes.ts",
        "$TURBO_ROOT$/packages/brand/src/**"
      ],
      "outputs": ["src/generated/**", "public/icons/**", "public/sw.js"]
    },
    "build": {
      "env": ["API_ORIGIN", "CONSOLE_ORIGIN", "STORAGE_ORIGIN", "CACHE_VERSION"]
    }
  }
}
