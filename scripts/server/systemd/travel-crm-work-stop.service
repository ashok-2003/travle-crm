# Stops the background work (the worker, or the console) when the working hours end, from travel-crm-work-stop.timer;
# running jobs get their 30 seconds. Installed by scripts/server/work-hours.sh. Its log: journalctl -u travel-crm-work-stop
[Unit]
Description=travel-crm working hours: stop the background work
After=docker.service

[Service]
Type=oneshot
ExecStart=/srv/travel-crm/app/scripts/server/work-hours.sh stop
