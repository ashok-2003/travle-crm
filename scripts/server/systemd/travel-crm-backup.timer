# Starts travel-crm-backup.service every night at 01:30 India time (20:00 UTC), and at boot if the server was off
# then. Installed by scripts/server/setup.sh. When it last and next runs: systemctl list-timers travel-crm-backup
[Unit]
Description=travel-crm nightly database backup, at 01:30 India time

[Timer]
OnCalendar=*-*-* 20:00:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
