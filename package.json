{
  "name": "travel-crm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "license": "UNLICENSED",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "check": "pnpm run format:check && turbo run typecheck lint test e2e && pnpm run depcruise",
    "db:up": "docker compose up -d --wait postgres",
    "services:up": "docker compose up -d --wait postgres minio mailpit && docker compose run --rm minio-bucket",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @travel-crm/db db:migrate:deploy",
    "e2e": "turbo run e2e",
    "images:smoke": "scripts/docker/smoke-images.sh",
    "product:up": "docker compose --file docker-compose.product.yml up --detach --build --wait && docker compose --file docker-compose.product.yml run --rm --no-deps console demo",
    "product:down": "docker compose --file docker-compose.product.yml down",
    "product:smoke": "scripts/docker/smoke-product.sh",
    "lighthouse": "turbo run build --filter=@travel-crm/web && pnpm --filter @travel-crm/web lighthouse",
    "migrations:check": "scripts/ci/check-migrations.sh",
    "workflows:lint": "scripts/ci/lint-workflows.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "dependency-cruiser": "18.6.0",
    "eslint": "catalog:",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "turbo": "2.11.8",
    "typescript": "catalog:"
  }
}
