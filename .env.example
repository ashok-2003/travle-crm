# The Compose project of this checkout's Docker services (scripts/dev/compose.sh). Unset, it is travel-crm-<a checksum
# of the checkout's full path>, so each clone and worktree has containers and volumes of its own. A checkout whose
# containers were made before that (travel-crm-postgres-1 and the rest) keeps them, and their data, with this line
# (and a copy of that .env in another checkout would share them):
# COMPOSE_PROJECT_NAME=travel-crm

# Local Postgres from docker-compose.yml. Dev-only passwords, set in packages/db/sql/bootstrap.sql.
DATABASE_MIGRATOR_URL=postgresql://app_migrator:migrator@localhost:55432/travel_crm
DATABASE_URL=postgresql://app_runtime:runtime@localhost:55432/travel_crm
DATABASE_PLATFORM_URL=postgresql://app_platform:platform@localhost:55432/travel_crm

# The api (apps/api). Dev-only secret: generate a real one with `openssl rand -base64 32`.
# NODE_ENV is production when unset: https, rate limiting and a strong secret are then required.
NODE_ENV=development
# The least important log line (debug, info, warn, error). Unset: info in production, debug in development.
# LOG_LEVEL=debug
# Also ship every log line to Axiom (docs/runbook.md, "Turn on Axiom"): both, or neither. Secrets.
# AXIOM_TOKEN=
# AXIOM_DATASET=
# Axiom's EU region: AXIOM_URL=https://api.eu.axiom.co (default https://api.axiom.co)
# AXIOM_URL=
BETTER_AUTH_SECRET=dev-only-secret-not-for-any-real-deploy
BETTER_AUTH_URL=http://localhost:3001
# The web app's address in development (plan 5), allowed to call the api with cookies.
TRUSTED_ORIGINS=http://localhost:3000
# Behind a load balancer, either have it overwrite x-forwarded-for with the single client address, or list the
# proxies' IPs/CIDRs here (comma-separated) so the client address is read from the right of the header.
# AUTH_TRUSTED_PROXIES=10.0.0.0/8
# The website form's visitor address (W32): how many entries our own proxies append to x-forwarded-for, 1 to 5. Unset,
# the form reads the address as sign-in does. On Render behind Vercel, measure it at /api/public/client-address.
# PUBLIC_FORM_PROXY_HOPS=
# Cloudflare Turnstile for the website form, both or neither. These are Cloudflare's published test keys: the widget
# always passes. A real deploy creates its own widget in Cloudflare.
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
PORT=3001

# The web app (plan 5) in development: links in emails point there, and password resets come back to it.
APP_URL=http://localhost:3000

# Object storage: MinIO from docker-compose.yml (console at http://localhost:59001). In the cloud, leave S3_ENDPOINT
# out, set the bucket's region, and use credentials from the secret manager.
S3_ENDPOINT=http://localhost:59000
S3_REGION=ap-south-1
S3_BUCKET=travel-crm
S3_ACCESS_KEY_ID=minio-dev
S3_SECRET_ACCESS_KEY=minio-dev-secret
S3_FORCE_PATH_STYLE=true

# Email: Mailpit from docker-compose.yml catches everything; read it at http://localhost:58025.
SMTP_HOST=localhost
SMTP_PORT=51025
EMAIL_FROM_ADDRESS=no-reply@travel-crm.localhost

# Web push. A dev-only key pair: make your own for any real deploy with
# `pnpm --filter @travel-crm/integrations exec web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=BNDwagd-1gwbRjL1o3iP9g4zUvYkczzP1yE9xNbcidEzKkDbvrHaBCyHQi8btoNnI9IMV7CoQun_1oMlSCz5lTY
VAPID_PRIVATE_KEY=UrS7-d1PFp4TPIVRSD5qGMXmRPN_NbpYvsJxhc6j3nU
VAPID_SUBJECT=mailto:dev@travel-crm.localhost

# The platform console (the api's `console` command): its own port, and the only process that reads
# DATABASE_PLATFORM_URL. The shared demo it resets every night is off unless both DEMO_ variables are set; it is on a
# plan of its own, which the reset makes and never puts on sale.
CONSOLE_PORT=3002
# DEMO_ORGANIZATION_CODE=DEMO
# DEMO_PASSWORD=demo-only-password

# Google Sheets sync (ADR 0031): off unless both are set; the app then says "Google Sheets is off". A service account's
# key file, as base64 on one line (`base64 -i key.json | tr -d '\n'`) or a list of several as JSON, and a random key of at
# least 32 characters (`openssl rand -base64 32`) that is never changed once agencies connect sheets. The api and the
# worker read the accounts; the console reads only the hash key. Never commit a real key. `pnpm dev` and `pnpm product:up`
# pass both through.
GOOGLE_SHEETS_SERVICE_ACCOUNTS=
SHEETS_HASH_KEY=
