{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": ["PRISMA_HIDE_UPDATE_MESSAGE"],
  "tasks": {
    "generate": {
      "dependsOn": ["^generate"],
      "inputs": ["prisma/schema/**", "prisma.config.ts", "package.json"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate", "^generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": { "dependsOn": ["generate", "^generate"], "outputs": [] },
    "lint": { "dependsOn": ["generate", "^generate"], "outputs": [] },
    "test": {
      "dependsOn": ["generate", "^generate"],
      "outputs": [],
      "passThroughEnv": ["DOCKER_HOST", "TESTCONTAINERS_*"]
    },
    // The product-name check reads every file in the repository, but turbo keys a task's cache on its own package's
    // files only, so a cached run would pass after the name was typed in another package. It is fast: never cache it.
    "@travel-crm/brand#test": {
      "dependsOn": ["generate", "^generate"],
      "outputs": [],
      "cache": false
    },
    // The raw-SQL guard's test lints with the domain package's real overrides, which live outside this package.
    "@travel-crm/eslint-config#test": {
      "dependsOn": ["generate", "^generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/domain/eslint.config.js"],
      "outputs": []
    },
    "db:migrate:deploy": { "cache": false, "env": ["DATABASE_MIGRATOR_URL"] },
    // `pnpm dev` runs these three at once, after the generated code (Prisma's client, the brand's files) exists.
    "dev": { "dependsOn": ["generate", "^generate"], "cache": false, "persistent": true },
    "worker": { "dependsOn": ["^generate"], "cache": false, "persistent": true },
    "console": { "dependsOn": ["^generate"], "cache": false, "persistent": true },
    "e2e": {
      "dependsOn": ["generate", "^generate", "typecheck", "lint"],
      "cache": false,
      "passThroughEnv": ["DOCKER_HOST", "TESTCONTAINERS_*"]
    }
  }
}
