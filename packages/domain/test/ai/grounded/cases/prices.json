[
  {
    "name": "A price the model typed is asked again, then sent through the code",
    "chat": [{ "from": "customer", "text": "Manali on 14 Nov for 2 people, what is the price?" }],
    "scripted": {
      "read": {
        "places": [{ "destination": "D2", "words": "Manali", "evidence": "Manali on 14 Nov" }],
        "startsOn": { "date": "2026-11-14", "month": null, "evidence": "14 Nov" },
        "travellers": { "count": 2, "evidence": "2 people" },
        "wants": "price",
        "wantsEvidence": "what is the price"
      },
      "write": [
        { "reply": "Manali is ₹7,999 per person for you." },
        { "reply": "Manali on [departure P1] is [price P1 double] per person." }
      ]
    },
    "expect": {
      "sent": true,
      "includes": ["₹6,999", "14 Nov"],
      "excludes": ["7,999"],
      "flagged": false,
      "messages": 1
    }
  },
  {
    "name": "A typed price twice: nothing is sent and the team is told",
    "chat": [{ "from": "customer", "text": "Manali on 14 Nov for 2 people, what is the price?" }],
    "scripted": {
      "read": {
        "places": [{ "destination": "D2", "words": "Manali", "evidence": "Manali on 14 Nov" }],
        "startsOn": { "date": "2026-11-14", "month": null, "evidence": "14 Nov" },
        "travellers": { "count": 2, "evidence": "2 people" },
        "wants": "price",
        "wantsEvidence": "what is the price"
      },
      "write": [{ "reply": "Manali is ₹7,999 per person for you." }, { "reply": "It is only ₹7,999 per person." }]
    },
    "expect": {
      "sent": false,
      "flagged": true,
      "notices": 1,
      "blockedReason": "amount",
      "messages": 0
    }
  },
  {
    "name": "The final B2B rate is not made up: the team is told",
    "chat": [{ "from": "customer", "text": "What is your final B2B rate for Manali on 14 Nov, 2 people?" }],
    "scripted": {
      "read": {
        "places": [{ "destination": "D2", "words": "Manali", "evidence": "B2B rate for Manali" }],
        "startsOn": { "date": "2026-11-14", "month": null, "evidence": "14 Nov" },
        "travellers": { "count": 2, "evidence": "2 people" },
        "special": { "kind": "b2b", "evidence": "final B2B rate" },
        "wants": "price",
        "wantsEvidence": "final B2B rate"
      },
      "write": [
        {
          "reply": "I can't quote a special rate here. I have passed your request on, so the team can look at it and get back to you."
        }
      ]
    },
    "expect": {
      "sent": true,
      "includes": ["special rate"],
      "excludes": ["₹"],
      "flagged": true,
      "notices": 1,
      "blockedReason": "special_price",
      "messages": 1
    }
  },
  {
    "name": "A discount for a group is the team's to give",
    "chat": [{ "from": "customer", "text": "We are 10 people for Manali on 14 Nov, any discount?" }],
    "scripted": {
      "read": {
        "places": [{ "destination": "D2", "words": "Manali", "evidence": "10 people for Manali" }],
        "startsOn": { "date": "2026-11-14", "month": null, "evidence": "14 Nov" },
        "travellers": { "count": 10, "evidence": "10 people" },
        "special": { "kind": "group_rate", "evidence": "any discount" },
        "wants": "price",
        "wantsEvidence": "any discount"
      },
      "write": [{ "reply": "Group rates are something the team looks at. I have flagged your request for them." }]
    },
    "expect": {
      "sent": true,
      "excludes": ["₹", "% off"],
      "flagged": true,
      "blockedReason": "special_price",
      "messages": 1
    }
  },
  {
