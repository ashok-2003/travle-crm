        "places": [{ "destination": "D2", "words": "Manali", "evidence": "Manali 14 नवंबर" }],
        "startsOn": { "date": "2026-11-14", "month": null, "evidence": "14 नवंबर" },
        "travellers": { "count": 2, "evidence": "2 लोगों" },
        "wants": "price",
        "wantsEvidence": "रेट बताइए"
      },
      "write": [{ "reply": "Manali में [departure P1] को [price P1 double] प्रति व्यक्ति है।" }]
