[
  {
    "name": "A voice note: the reply asks the customer to type",
    "chat": [{ "from": "customer", "kind": "audio", "text": "" }],
    "scripted": {
      "read": { "wants": "other" },
      "write": [{ "reply": "I can't listen to voice notes here. Could you type your question for me?" }]
    },
    "expect": {
      "sent": true,
      "includes": ["type"],
      "excludes": ["₹"],
      "flagged": false,
      "messages": 1
    }
  },
  {
    "name": "A request for a person: handed over, the team told once",
    "chat": [{ "from": "customer", "text": "I want to talk to a person please" }],
    "scripted": {
      "read": { "wants": "person", "wantsEvidence": "talk to a person" },
      "write": [
        {
          "reply": "Of course. I am asking the team to call you.",
          "actions": { "handOver": "customer asked for a person" }
        }
      ]
    },
    "expect": {
      "sent": true,
      "includes": ["asking the team"],
      "actions": { "handOver": true },
      "flagged": true,
      "notices": 1,
      "messages": 1
    }
  },
  {
    "name": "Hinglish: the price comes from the code in the customer's language",
    "chat": [{ "from": "customer", "text": "Manali ka rate kya hai 14 Nov ke liye, 2 log hain" }],
    "scripted": {
      "read": {
        "places": [{ "destination": "D2", "words": "Manali", "evidence": "Manali ka rate" }],
        "startsOn": { "date": "2026-11-14", "month": null, "evidence": "14 Nov" },
        "travellers": { "count": 2, "evidence": "2 log" },
        "wants": "price",
        "wantsEvidence": "rate kya hai"
      },
      "write": [{ "reply": "Manali ka rate [departure P1] ke liye [price P1 double] per person hai." }]
    },
    "expect": {
      "sent": true,
      "includes": ["₹6,999", "14 Nov", "per person hai"],
      "flagged": false,
      "messages": 1
    }
  },
  {
