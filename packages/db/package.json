{
  "name": "@travel-crm/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./identity": "./src/identity.ts",
    "./platform": "./src/platform.ts",
    "./rate-limits": "./src/rate-limits.ts",
    "./webhooks": "./src/webhooks.ts",
    "./testing": "./test/testing.ts",
    "./testing/global-setup": "./test/global-setup.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@travel-crm/eslint-config": "workspace:*",
    "@travel-crm/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.7",
    "eslint": "catalog:",
    "prisma": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
