// Quotes (step 3, P0): a lead's quotation (its day-by-day plan and priced lines, GST on the total), the payments due on
// it and those received, and the numbered documents made from it (the quotation's PDF, the invoice, each receipt).
// Amounts are integer paise. Organization-owned, under row-level security.

/// A quotation for a lead. Soft-deleted (ADR 0004).
model Quote {
  /// Filled from db.forOrg()'s organization when omitted.
  organizationId     String             @default(dbgenerated("(NULLIF(current_setting('app.org_id'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  id                 String             @id @default(uuid(7)) @db.Uuid
  leadId             String             @map("lead_id") @db.Uuid
  title              String
  startDate          DateTime?          @map("start_date") @db.Date
  adults             Int                @default(2)
  children           Int                @default(0)
  /// [{ title, description }], one a day (CHECK quote_days_array).
  days               Json               @default("[]")
  /// [{ description, detail, quantity, unitPricePaise }] (CHECK quote_items_array).
  items              Json               @default("[]")
  inclusions         String             @default("")
  exclusions         String             @default("")
  notes              String             @default("")
  /// 0, 500 or 1800 (CHECK quote_tax_rate_value).
  taxRateBasisPoints Int                @default(500) @map("tax_rate_basis_points")
  /// A GST state code or OUTSIDE_INDIA; null is the agency's own state.
  placeOfSupply      String?            @map("place_of_supply")
  /// The agency's GST state when the quote was sent, frozen with its prices: its documents split the tax by it, never by
  /// the state the agency has today. Null for a draft.
  supplierStateCode  String?            @map("supplier_state_code")
  subtotalPaise      BigInt             @default(0) @map("subtotal_paise")
  taxPaise           BigInt             @default(0) @map("tax_paise")
  totalPaise         BigInt             @default(0) @map("total_paise")
  /// draft, sent, accepted, declined or replaced (CHECK quote_status_value). Only a draft is edited: a sent quote keeps its prices.
  status             String             @default("draft")
  /// The draft that took this quote's place ("Make a new version"); its link then says so. Set with status replaced.
  replacedById       String?            @map("replaced_by_id") @db.Uuid
  sentAt             DateTime?          @map("sent_at") @db.Timestamptz(6)
  acceptedAt         DateTime?          @map("accepted_at") @db.Timestamptz(6)
  /// The name the customer typed when accepting on the link; null when staff marked it.
  acceptedName       String?            @map("accepted_name")
  /// Counts every change, so the quotation's PDF is issued again only when the quote changed since.
  version            Int                @default(1)
  pdfDocumentId      String?            @map("pdf_document_id") @db.Uuid
  pdfVersion         Int?               @map("pdf_version")
  invoiceDocumentId  String?            @map("invoice_document_id") @db.Uuid
  createdBy          String?            @map("created_by") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz(6)
  deletedBy          String?            @map("deleted_by") @db.Uuid
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lead               Lead               @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  pdfDocument        IssuedDocument?    @relation("QuotePdf", fields: [organizationId, pdfDocumentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  invoiceDocument    IssuedDocument?    @relation("QuoteInvoice", fields: [organizationId, invoiceDocumentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Not RESTRICT: the purge deletes a table's rows in one statement, and a restricting key to a row of the same table would stop it.
  replacedBy         Quote?             @relation("QuoteReplacement", fields: [organizationId, replacedById], references: [organizationId, id], onDelete: NoAction, onUpdate: Restrict)
  replaces           Quote[]            @relation("QuoteReplacement")
  installments       QuoteInstallment[]
  payments           QuotePayment[]
  costs              TripCost[]

  @@unique([organizationId, id])
  @@index([organizationId, leadId], map: "quote_lead")
  @@map("quote")
}

/// A payment due on a quote: the advance, the balance before travel.
model QuoteInstallment {
  organizationId String       @default(dbgenerated("(NULLIF(current_setting('app.org_id'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  id             String       @id @default(uuid(7)) @db.Uuid
  quoteId        String       @map("quote_id") @db.Uuid
  label          String
  amountPaise    BigInt       @map("amount_paise")
  dueOn          DateTime     @map("due_on") @db.Date
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  quote          Quote        @relation(fields: [organizationId, quoteId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, quoteId], map: "quote_installment_quote")
  @@map("quote_installment")
}

/// Money a customer paid on a quote, as staff recorded it. Never deleted: a mistake is voided.
model QuotePayment {
  organizationId    String          @default(dbgenerated("(NULLIF(current_setting('app.org_id'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  id                String          @id @default(uuid(7)) @db.Uuid
  quoteId           String          @map("quote_id") @db.Uuid
  amountPaise       BigInt          @map("amount_paise")
  receivedOn        DateTime        @map("received_on") @db.Date
  /// upi, bank, cash, card or other (CHECK quote_payment_method_value).
  method            String
  reference         String          @default("")
  /// The browser's id for this recording, so a double tap or a retry records it once (null for none).
  requestId         String?         @map("request_id") @db.Uuid
  /// What this payment changed when it was the first on the quote, so voiding it puts both back: the quote's status
  /// (sent) and the lead's stage before. Null when it changed nothing.
  quoteStatusBefore String?         @map("quote_status_before")
  leadStageBefore   String?         @map("lead_stage_before")
  recordedBy        String?         @map("recorded_by") @db.Uuid
  receiptDocumentId String?         @map("receipt_document_id") @db.Uuid
  voidedAt          DateTime?       @map("voided_at") @db.Timestamptz(6)
  voidedBy          String?         @map("voided_by") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  quote             Quote           @relation(fields: [organizationId, quoteId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  receiptDocument   IssuedDocument? @relation("PaymentReceipt", fields: [organizationId, receiptDocumentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, requestId], map: "quote_payment_request_once")
  @@index([organizationId, quoteId], map: "quote_payment_quote")
  @@map("quote_payment")
}

/// How an agency's quotes are paid and taxed: its UPI id, the usual GST rate and the terms. One row each.
model QuoteSettings {
  organizationId            String       @id @default(dbgenerated("(NULLIF(current_setting('app.org_id'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  upiId                     String       @default("") @map("upi_id")
  upiName                   String       @default("") @map("upi_name")
  defaultTaxRateBasisPoints Int          @default(500) @map("default_tax_rate_basis_points")
  defaultTerms              String       @default("") @map("default_terms")
  updatedBy                 String?      @map("updated_by") @db.Uuid
  updatedAt                 DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("quote_settings")
}
