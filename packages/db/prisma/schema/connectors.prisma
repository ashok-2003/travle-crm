/// The ways leads and data come in and go out (release D): an agency's website forms and its incoming lead links, its
/// API keys, the webhooks it gets our events on (and each delivery), and its connections to other services (Meta lead
/// ads, IndiaMART, WhatsApp), whose credentials are kept encrypted.
model LeadCapture {
  /// Filled from db.forOrg()'s organization when omitted.
  organizationId String       @default(dbgenerated("(NULLIF(current_setting('app.org_id'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  id             String       @id @default(uuid(7)) @db.Uuid
  /// form (a hosted page and an embed for the agency's site) or link (a secret address other tools post leads to)
  /// (CHECK lead_capture_kind_value).
  kind           String
  name           String
  /// The sha256 of the token's secret; the token itself is shown once.
  tokenHash      String       @map("token_hash")
  /// What a form asks besides name and phone, and the words it shows (JSON, the contract's formSettings).
  settings       Json         @default("{}")
  createdBy      String?      @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  disabledAt     DateTime?    @map("disabled_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, tokenHash])
  @@map("lead_capture")
}

/// A key for the agency's own systems to call our API with.
model ApiKey {
  organizationId String       @default(dbgenerated("(NULLIF(current_setting('app.org_id'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  id             String       @id @default(uuid(7)) @db.Uuid
  name           String
  /// The key's first characters, shown so a person can tell keys apart.
  prefix         String
  keyHash        String       @map("key_hash")
  /// What it may do: leads:read, leads:write.
  scopes         String[]
  createdBy      String?      @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt     DateTime?    @map("last_used_at") @db.Timestamptz(6)
  revokedAt      DateTime?    @map("revoked_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, keyHash])
  @@map("api_key")
}

/// An address the agency gets our events at, signed with its secret.
model WebhookSubscription {
  organizationId String            @default(dbgenerated("(NULLIF(current_setting('app.org_id'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  id             String            @id @default(uuid(7)) @db.Uuid
  url            String
  /// The event types it hears, e.g. lead.created.
  events         String[]
  /// The signing secret, shown to the agency; each delivery carries its HMAC-SHA256.
  secret         String
  createdBy      String?           @map("created_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  disabledAt     DateTime?         @map("disabled_at") @db.Timestamptz(6)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deliveries     WebhookDelivery[]

  @@unique([organizationId, id])
  @@map("webhook_subscription")
}

/// One event sent to one subscription: tried, and retried, until delivered or given up.
model WebhookDelivery {
  organizationId String              @default(dbgenerated("(NULLIF(current_setting('app.org_id'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  id             String              @id @default(uuid(7)) @db.Uuid
  subscriptionId String              @map("subscription_id") @db.Uuid
  eventId        String              @map("event_id") @db.Uuid
  eventType      String              @map("event_type")
  /// What is sent: the event's ids and the lead's public fields when it was queued.
  payload        Json                @default("{}")
  /// pending, delivered or failed (CHECK webhook_delivery_status_value).
  status         String              @default("pending")
  attempts       Int                 @default(0)
  responseStatus Int?                @map("response_status")
  lastError      String?             @map("last_error")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  deliveredAt    DateTime?           @map("delivered_at") @db.Timestamptz(6)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subscription   WebhookSubscription @relation(fields: [organizationId, subscriptionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, subscriptionId, eventId])
  @@index([organizationId, subscriptionId, createdAt(sort: Desc)], map: "webhook_delivery_latest")
  @@map("webhook_delivery")
}

/// The agency's connection to another service: a Meta page for lead ads, an IndiaMART account, a WhatsApp number.
model Connection {
  organizationId String       @default(dbgenerated("(NULLIF(current_setting('app.org_id'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  id             String       @id @default(uuid(7)) @db.Uuid
  /// meta_lead_ads, indiamart or whatsapp (CHECK connection_provider_value).
  provider       String
  /// The service's own id for it: the page id, the IndiaMART account, the WhatsApp phone number id.
  externalId     String       @map("external_id")
  /// What people see: the page's name, the number.
  name           String
  /// connected, needs_attention or disconnected (CHECK connection_status_value).
  status         String       @default("connected")
  /// The credentials, AES-256-GCM encrypted with INTEGRATION_SECRETS_KEY.
  credentials    String
  /// Provider settings (JSON): a WhatsApp account's ids, the field matches of a lead form.
  settings       Json         @default("{}")
  lastSyncedAt   DateTime?    @map("last_synced_at") @db.Timestamptz(6)
  lastError      String?      @map("last_error")
  createdBy      String?      @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, provider, externalId])
  @@map("connection")
}

/// A lead that came from another service, once: the service's own id for it, so a repeat never makes two leads.
model LeadReceipt {
  organizationId String       @default(dbgenerated("(NULLIF(current_setting('app.org_id'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  id             String       @id @default(uuid(7)) @db.Uuid
  provider       String
  externalId     String       @map("external_id")
  leadId         String?      @map("lead_id") @db.Uuid
  receivedAt     DateTime     @default(now()) @map("received_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, provider, externalId])
  @@map("lead_receipt")
}
