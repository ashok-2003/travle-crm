// The platform's own records (spec 5 and 7), kept by the console, never by an organization's staff. Not organization-
// owned: no organization_id and no row-level security. The runtime role has no rights on these tables at all.

/// The platform log: what platform staff did in the console, and what the platform's own jobs did. Append-only. It
/// names organizations by id without a foreign key, so it outlives an organization's purge (spec 5).
model PlatformAuditEntry {
  id                   String   @id @default(uuid(7)) @db.Uuid
  occurredAt           DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  /// The platform admin who acted, or null for the platform's own jobs (the nightly demo reset).
  actorUserId          String?  @map("actor_user_id") @db.Uuid
  /// "<entity>.<what happened>", e.g. "organization.onboarded" (CHECK platform_audit_entry_action_format).
  action               String
  /// The kind of thing acted on, e.g. "organization", "plan", "platform_staff", "job".
  targetType           String   @map("target_type")
  /// Its id: a UUID, or for jobs a queue name or job id.
  targetId             String   @map("target_id")
  /// The organization the entry concerns, when there is one.
  targetOrganizationId String?  @map("target_organization_id") @db.Uuid
  /// The fields that changed, as JSON objects; no secrets and no personal data, as in the organizations' log.
  before               Json?
  after                Json?

  /// The log, newest first.
  @@index([occurredAt(sort: Desc), id(sort: Desc)], map: "platform_audit_entry_newest")
  /// One organization's entries, newest first.
  @@index([targetOrganizationId, occurredAt(sort: Desc)], map: "platform_audit_entry_organization")
  @@map("platform_audit_entry")
}

/// Stored files still to delete after a purge or an erasure committed: the deletions' outbox (ADR 0022). A row is
/// written in the same platform transaction as the rows it follows; the console's job deletes the file, then the row,
/// and is retried until none is left. Ids only: the storage key is made from them, never stored, so no file name is
/// kept. Its organization column is not organization_id: the row must outlive the purge, whose catalog walk deletes
/// every table with one.
model StoredFileDeletion {
  id                   String   @id @default(uuid(7)) @db.Uuid
  /// The organization whose storage folder holds the file. No foreign key: the organization may be gone.
  targetOrganizationId String   @map("target_organization_id") @db.Uuid
  /// The attachment whose bytes go; null for everything in the organization's folder (a purge).
  attachmentId         String?  @map("attachment_id") @db.Uuid
  /// Not before then: a purge sweeps its organization's folder again once upload links handed out before it lapse.
  dueAt                DateTime @default(now()) @map("due_at") @db.Timestamptz(6)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// The job's work list: what is due, oldest first.
  @@index([dueAt, id])
  @@map("stored_file_deletion")
}

/// An export of one organization's data (spec 5: "export, typed confirmation, purge job"), which the console's job
/// writes to the platform's own storage, platform/exports/<organization>/<export>/: its rows as JSON lines a part at a
/// time, and a copy of each of its files. Kept 7 days, or until an erasure in the organization withdraws it, then its
/// parts and copies are deleted and it is marked expired. It names its organization by id without a foreign key, so
/// it outlives the organization's purge (whose catalog sweep looks for organization_id), and the runtime role has no
/// rights on it. The row itself stays, ids and counts only.
model PlatformExport {
  id                   String               @id @default(uuid(7)) @db.Uuid
  targetOrganizationId String               @map("target_organization_id") @db.Uuid
  /// The super admin who asked for it.
  requestedBy          String               @map("requested_by") @db.Uuid
  requestedAt          DateTime             @map("requested_at") @db.Timestamptz(6)
  /// requested, done, failed (its last attempt failed; a retry may still finish it) or expired: no longer to be
  /// downloaded (CHECK platform_export_state_value).
  state                String               @default("requested")
  /// The most parts any attempt stored: what the expiry deletes, with the copies in files.
  partsWritten         Int                  @default(0) @map("parts_written")
  /// Once done: its parts, the table rows and the people in them, and the files copied.
  partCount            Int?                 @map("part_count")
  rowCount             Int?                 @map("row_count")
  personCount          Int?                 @map("person_count")
  fileCount            Int?                 @map("file_count")
  completedAt          DateTime?            @map("completed_at") @db.Timestamptz(6)
  /// When its parts are deleted: 7 days after it was asked for.
  expiresAt            DateTime             @map("expires_at") @db.Timestamptz(6)
  expiredAt            DateTime?            @map("expired_at") @db.Timestamptz(6)
  /// When its parts and copies were deleted from storage; null until then, after it expired too.
  clearedAt            DateTime?            @map("cleared_at") @db.Timestamptz(6)
  files                PlatformExportFile[]

  /// One organization's exports, newest first.
  @@index([targetOrganizationId, requestedAt(sort: Desc)], map: "platform_export_organization")
  /// The exports the expiry job looks for.
  @@index([state, expiresAt], map: "platform_export_due")
  @@map("platform_export")
}

/// A file an export copied beside itself, to platform/exports/<organization>/<export>/files/<attachment>: what its
/// download links to and its expiry deletes. Ids only.
model PlatformExportFile {
  exportId     String         @map("export_id") @db.Uuid
  attachmentId String         @map("attachment_id") @db.Uuid
  export       PlatformExport @relation(fields: [exportId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([exportId, attachmentId])
  @@map("platform_export_file")
}
