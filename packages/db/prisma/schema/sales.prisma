// Sales execution (the owner's focus of 2026-10-27): what turns more leads into bookings without anyone remembering to.
// The agency's automation settings (the first WhatsApp to a new lead, the follow-ups when they go quiet, the payment
// reminders, what makes a lead hot), each lead's follow-up run, every automatic touch (its key makes a repeat nothing),
// the signals that make a lead hot, and the agency's ready packages a quote starts from. Organization-owned, under RLS.

/// How the agency's sales run by themselves. One row each.
model SalesAutomation {
  /// Filled from db.forOrg()'s organization when omitted. Also the key: one row per organization.
  organizationId     String       @id @default(dbgenerated("(NULLIF(current_setting('app.org_id'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  /// The first WhatsApp to a lead that arrived by itself (an ad, the website, a sheet), within a minute.
  speedEnabled       Boolean      @default(false) @map("speed_enabled")
  speedTemplateId    String?      @map("speed_template_id") @db.Uuid
  /// What fills each blank of the template: a field key (name, destination...) or "text:<words>".
  speedParams        String[]     @default([]) @map("speed_params")
  /// The nudges to a lead who has not written back: [{ days, templateId, params }], in order.
  /// The agency's word that someone who enquires with their number agreed to hear back on WhatsApp.
  contactEnquirers   Boolean      @default(false) @map("contact_enquirers")
  followEnabled      Boolean      @default(false) @map("follow_enabled")
  followSteps        Json         @default("[]") @map("follow_steps")
  /// A payment due on an accepted quote: a reminder some days before, and once the day after it is missed.
  reminderEnabled    Boolean      @default(false) @map("reminder_enabled")
  reminderTemplateId String?      @map("reminder_template_id") @db.Uuid
  reminderParams     String[]     @default([]) @map("reminder_params")
  reminderDaysBefore Int          @default(1) @map("reminder_days_before")
  /// Words in a customer's message that make the lead hot ("price", "book"), lower case.
  hotKeywords        String[]     @default(["price", "rate", "book", "booking", "confirm", "advance", "payment", "kitna"]) @map("hot_keywords")
  /// A budget for everyone at or over this is hot; null for none.
  hotBudgetPaise     BigInt?      @map("hot_budget_paise")
  /// A trip starting within this many days is hot.
  hotTravelDays      Int          @default(30) @map("hot_travel_days")
  updatedBy          String?      @map("updated_by") @db.Uuid
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("sales_automation")
}

/// A lead's run of follow-ups: the next nudge and when, until the customer writes, the lead closes or someone stops it.
model LeadCadence {
  organizationId String       @default(dbgenerated("(NULLIF(current_setting('app.org_id'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  id             String       @id @default(uuid(7)) @db.Uuid
  leadId         String       @map("lead_id") @db.Uuid
  enrolledAt     DateTime     @map("enrolled_at") @db.Timestamptz(6)
  /// The index of the next step in the settings' follow-ups.
  step           Int          @default(0)
  nextAt         DateTime     @map("next_at") @db.Timestamptz(6)
  /// active, done or stopped (CHECK lead_cadence_state_value).
  state          String       @default("active")
  /// replied, closed, by_hand, no_phone, opted_out, template (why it stopped).
  stopReason     String?      @map("stop_reason")
  stoppedBy      String?      @map("stopped_by") @db.Uuid
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lead           Lead         @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, leadId], map: "lead_cadence_one_per_lead")
  @@index([organizationId, state, nextAt], map: "lead_cadence_due")
  @@map("lead_cadence")
}

/// Every automatic touch: the first message, a follow-up, a payment reminder. Its key makes a repeat nothing.
model SalesTouch {
  organizationId String       @default(dbgenerated("(NULLIF(current_setting('app.org_id'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  id             String       @id @default(uuid(7)) @db.Uuid
  /// speed, follow or reminder (CHECK sales_touch_kind_value).
  kind           String
  /// "speed:<lead>", "follow:<lead>:<step>", "reminder:<instalment>:before" ...
  key            String
  leadId         String?      @map("lead_id") @db.Uuid
  /// sent or skipped, with why when skipped.
  outcome        String
  reason         String?
  messageId      String?      @map("message_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, key], map: "sales_touch_once")
  @@index([organizationId, leadId], map: "sales_touch_lead")
  @@map("sales_touch")
}

/// Something a customer did that says they are ready to buy: opened the quote, asked the price.
model LeadSignal {
  organizationId String       @default(dbgenerated("(NULLIF(current_setting('app.org_id'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  id             String       @id @default(uuid(7)) @db.Uuid
  leadId         String       @map("lead_id") @db.Uuid
  /// quote_opened or asked_price (CHECK lead_signal_kind_value).
  kind           String
  /// The event it came from, so a repeat adds nothing.
  sourceKey      String       @map("source_key")
  at             DateTime     @db.Timestamptz(6)
  /// When a person marked the opened quote Done on Today, so it does not come back; null until then.
  dismissedAt    DateTime?    @map("dismissed_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lead           Lead         @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, sourceKey], map: "lead_signal_once")
  @@index([organizationId, leadId, at], map: "lead_signal_lead")
  @@map("lead_signal")
}

/// A ready package ("Manali 5 days") a quote starts from in one tap, and (release 7b) a page of its own the agency may publish at
/// /a/<sign-in code>/<slug>. Soft-deleted (ADR 0004).
model QuoteTemplate {
  organizationId        String              @default(dbgenerated("(NULLIF(current_setting('app.org_id'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  id                    String              @id @default(uuid(7)) @db.Uuid
  name                  String
  title                 String
  days                  Json                @default("[]")
  items                 Json                @default("[]")
  inclusions            String              @default("")
  exclusions            String              @default("")
  notes                 String              @default("")
  taxRateBasisPoints    Int                 @default(500) @map("tax_rate_basis_points")
  /// Lower-case letters, digits and hyphens (CHECK quote_template_slug_shape); null until the agency gives the package a page.
  slug                  String?
  destinationId         String?             @map("destination_id") @db.Uuid
  nights                Int?
  summary               String              @default("")
  /// ["short line", ...] (CHECK quote_template_highlights_array).
  highlights            Json                @default("[]")
  /// from or on_enquiry (CHECK quote_template_price_display_value).
  priceDisplay          String              @default("on_enquiry") @map("price_display")
  /// Per person, in paise, entered by staff; never refreshed by itself.
  fromPricePaise        BigInt?             @map("from_price_paise")
  published             Boolean             @default(false)
  /// basic, detailed or international (release 6's booking level), or null for the agency's default.
  defaultTravellerLevel String?             @map("default_traveller_level")
  cancellationNotes     String              @default("") @map("cancellation_notes")
  /// custom or group (CHECK quote_template_kind_value). A group package sells departures: seasons price it per person.
  kind                  String              @default("custom")
  /// Room types a group package sells: single, double, triple, quad, child_bed, child_no_bed (CHECK quote_template_room_types_value).
  roomTypes             String[]            @default([]) @map("room_types")
  pricesIncludeGst      Boolean             @default(true) @map("prices_include_gst")
  advancePerPersonPaise BigInt?             @map("advance_per_person_paise")
  paymentDetails        String              @default("") @map("payment_details")
  pickupPoints          String              @default("") @map("pickup_points")
  startCity             String              @default("") @map("start_city")
  /// Days it departs, 0 Sunday to 6 Saturday (CHECK quote_template_weekly_days_value).
  weeklyDays            Int[]               @default([]) @map("weekly_days")
  /// Months it departs, 1 to 12; empty means every month (CHECK quote_template_departure_months_value).
  departureMonths       Int[]               @default([]) @map("departure_months")
  seatsPerDeparture     Int?                @map("seats_per_departure")
  /// The AI may sell this package (any kind, once its gaps are closed: decided in the domain).
  aiSellable            Boolean             @default(false) @map("ai_sellable")
  createdBy             String?             @map("created_by") @db.Uuid
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?           @map("deleted_at") @db.Timestamptz(6)
  deletedBy             String?             @map("deleted_by") @db.Uuid
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  destination           Destination?        @relation(fields: [organizationId, destinationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  tiers                 QuoteTemplateTier[]
  seasons               PackageSeason[]
  departures            Departure[]
  quotes                Quote[]
  enquiries             PackageEnquiry[]
  whatsappAds           WhatsappAd[]

  @@unique([organizationId, id])
  @@unique([organizationId, name], map: "quote_template_live_name", where: { deletedAt: null })
  @@unique([organizationId, slug], map: "quote_template_live_slug", where: { deletedAt: null })
  @@map("quote_template")
}
