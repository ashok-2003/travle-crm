// The AI (ADR 0029; the owner's decision of 2026-10-28), step 1: an agency's own switch and instructions, what it tells its
// AI to know (typed words, or a PDF's), how many AI calls it used this month (shared by every AI feature), the drafts Suggest
// reply made (ids and a hash, never the words, so a sent reply can be audited as "drafted by AI, sent by <member>"), and the
// AI's guess of how each lead will go. Organization-owned, under RLS.

/// An agency's AI settings: off until its Owner or Admin turns it on. One row each.
model AiSettings {
  organizationId String       @id @default(dbgenerated("(NULLIF(current_setting('app.org_id'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  enabled        Boolean      @default(false)
  /// What the agency tells its AI: tone, language, what to offer, what never to say (CHECK ai_settings_instructions_length, at most 4000 characters).
  instructions   String       @default("")
  /// The AI scores each lead from its chat (the chance to book, why, the next step); the Owner or Admin can turn it off.
  scoring        Boolean      @default(true)
  updatedBy      String?      @map("updated_by") @db.Uuid
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("ai_settings")
}

/// AI calls made in a month by every AI feature, for the monthly limit. The month is its first day in the organization's zone.
model AiUsage {
  organizationId String       @default(dbgenerated("(NULLIF(current_setting('app.org_id'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  id             String       @id @default(uuid(7)) @db.Uuid
  month          DateTime     @db.Date
  calls          Int          @default(0)
  /// The tokens those calls used, as the provider counted them, for the console's cost figures.
  inputTokens    BigInt       @default(0) @map("input_tokens")
  outputTokens   BigInt       @default(0) @map("output_tokens")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, month], map: "ai_usage_month_key")
  @@map("ai_usage")
}

/// A reply the AI drafted for a member. It keeps no words: a hash of the draft says whether the member changed it before
/// sending, and `usedAt` that it was sent (once).
model AiDraft {
  organizationId String               @default(dbgenerated("(NULLIF(current_setting('app.org_id'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  id             String               @id @default(uuid(7)) @db.Uuid
  conversationId String               @map("conversation_id") @db.Uuid
  draftedBy      String               @map("drafted_by") @db.Uuid
  model          String
  textHash       String               @map("text_hash")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt         DateTime?            @map("used_at") @db.Timestamptz(6)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  conversation   WhatsappConversation @relation(fields: [organizationId, conversationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, conversationId], map: "ai_draft_conversation")
  @@map("ai_draft")
}

/// Something the AI knows about the agency: its packages, prices, inclusions and policies, typed or read from a document.
/// Soft-deleted (its file goes with it).
model AiKnowledge {
  organizationId String       @default(dbgenerated("(NULLIF(current_setting('app.org_id'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  id             String       @id @default(uuid(7)) @db.Uuid
  title          String
  body           String       @default("")
  /// text or file (CHECK ai_knowledge_kind_value).
  kind           String       @default("text")
  /// A file's attachment (record type ai_knowledge) and name, whose words become the body.
  attachmentId   String?      @map("attachment_id") @db.Uuid
  fileName       String?      @map("file_name")
  /// ready, reading (a file's words are being read) or failed (CHECK ai_knowledge_status_value).
  status         String       @default("ready")
  enabled        Boolean      @default(true)
  createdBy      String?      @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)
  deletedBy      String?      @map("deleted_by") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@map("ai_knowledge")
}

/// The AI's guess of how a lead will go: how likely it books (0-100), hot, warm or cold, why, whether it looks fake, what to
/// do next. A guess, shown as one; it never moves a lead's stage. Only agencies with the AI on have them; erased with the customer.
model LeadAiInsight {
  organizationId String       @default(dbgenerated("(NULLIF(current_setting('app.org_id'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  id             String       @id @default(uuid(7)) @db.Uuid
  leadId         String       @map("lead_id") @db.Uuid
  score          Int
  /// hot, warm or cold (CHECK lead_ai_insight_label_value).
  label          String
  reasons        String[]     @default([])
  fake           Boolean      @default(false)
  fakeReason     String?      @map("fake_reason")
  nextStep       String       @default("") @map("next_step")
  /// A line or two on how the lead stands, for the lead page.
  summary        String       @default("")
  /// What the customer said they want, as words: { destination, when, travellers, budget } (CHECK lead_ai_insight_facts_object).
  facts          Json         @default("{}")
  model          String       @default("")
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lead           Lead         @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, leadId], map: "lead_ai_insight_one_per_lead")
  @@map("lead_ai_insight")
}

/// How the agency's autopilot works (the AI answering WhatsApp chats by itself, AI step 2): off until an Owner or Admin turns
/// it on, then how it speaks, when it follows up, and whose way of talking it copies. One row each.
model AiAutopilot {
  organizationId   String       @id @default(dbgenerated("(NULLIF(current_setting('app.org_id'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  /// The AI answers customers by itself in every chat that doesn't say otherwise. Off by default.
  autopilot        Boolean      @default(false)
  /// The name it signs as, e.g. "Riya from Sharma Holidays"; empty for the agency's name.
  agentName        String       @default("") @map("agent_name")
  /// Hours of a customer's silence, inside the 24-hour window, before it nudges once; 0 for never.
  followUpHours    Int          @default(4) @map("follow_up_hours")
  /// The most it writes in one chat in a day, so a loop can't run away.
  maxRepliesPerDay Int          @default(25) @map("max_replies_per_day")
  /// customer, english, hindi, hinglish or other (CHECK ai_autopilot_language_value).
  language         String       @default("customer")
  languageOther    String       @default("") @map("language_other")
  /// human, short or points (CHECK ai_autopilot_style_value).
  style            String       @default("human")
  /// none, few or many (CHECK ai_autopilot_emojis_value).
  emojis           String       @default("few")
  /// friendly, professional or enthusiastic (CHECK ai_autopilot_tone_value).
  tone             String       @default("friendly")
  /// alert (never hands over by itself; flags the team), asked or careful (CHECK ai_autopilot_handoff_value).
  handoff          String       @default("alert")
  /// It chooses whether and when to follow up each quiet customer, inside the window.
  smartFollowUp    Boolean      @default(true) @map("smart_follow_up")
  /// It learns from the agency's chats each night (they go to the AI provider, numbers and emails taken out). Off by default.
  learning         Boolean      @default(false)
  learnedAt        DateTime?    @map("learned_at") @db.Timestamptz(6)
  /// The staff member whose way of talking it copies (from their own messages in a WhatsApp export): their name, the style
  /// guide the model wrote and a few of their own messages. Never the customer's side.
  voiceName        String?      @map("voice_name")
  voiceProfile     String?      @map("voice_profile")
  voiceExamples    String[]     @default([]) @map("voice_examples")
  /// sales (a sales agent) or natural (an everyday conversation as the copied person) (CHECK ai_autopilot_persona_value).
  persona          String       @default("sales")
  /// It writes a short note on the lead when a chat tells it something worth keeping.
  leadNotes        Boolean      @default(true) @map("lead_notes")
  /// It sends the agency's media (photos, videos, PDFs) when they help.
  sendMedia        Boolean      @default(true) @map("send_media")
  /// How customers pay (UPI ID, bank account, a payment link), sent exactly as written when someone wants to book.
  paymentDetails   String       @default("") @map("payment_details")
  /// Rules it always follows, whatever else it is told.
  strictRules      String       @default("") @map("strict_rules")
  updatedBy        String?      @map("updated_by") @db.Uuid
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("ai_autopilot")
}

/// A chat's autopilot state: whether it answers here, whether it handed the chat to a person and why, what it remembers of
/// the conversation, what it is doing now and what it planned next.
model AiChat {
  organizationId  String               @default(dbgenerated("(NULLIF(current_setting('app.org_id'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  id              String               @id @default(uuid(7)) @db.Uuid
  conversationId  String               @map("conversation_id") @db.Uuid
  /// default (the agency's), on or off (CHECK ai_chat_mode_value).
  mode            String               @default("default")
  handedOffAt     DateTime?            @map("handed_off_at") @db.Timestamptz(6)
  handoffReason   String?              @map("handoff_reason")
  /// The conversation so far, as the agent keeps it: facts, wishes, what was promised.
  memory          String               @default("")
  lastReplyAt     DateTime?            @map("last_reply_at") @db.Timestamptz(6)
  /// The day (UTC) the reply count is for, and the count.
  repliesOn       DateTime?            @map("replies_on") @db.Date
  repliesCount    Int                  @default(0) @map("replies_count")
  /// The last nudge, so a silent customer gets one per silence.
  lastNudgeAt     DateTime?            @map("last_nudge_at") @db.Timestamptz(6)
  /// What it is doing now, for the inbox: queued or thinking, else null (CHECK ai_chat_turn_state_value).
  turnState       String?              @map("turn_state")
  turnAt          DateTime?            @map("turn_at") @db.Timestamptz(6)
  followUpAt      DateTime?            @map("follow_up_at") @db.Timestamptz(6)
  followUpReason  String?              @map("follow_up_reason")
  /// What it flagged for the team while it kept answering ("wants to book"), and when.
  attentionReason String?              @map("attention_reason")
  attentionAt     DateTime?            @map("attention_at") @db.Timestamptz(6)
  /// The way of talking the AI copies in this chat alone, over the agency's (from an imported chat export).
  voiceName       String?              @map("voice_name")
  voiceProfile    String?              @map("voice_profile")
  voiceExamples   String[]             @default([]) @map("voice_examples")
  /// What the imported chat says the two talked about before: topics, plans, likes, how they are with each other.
  voiceContext    String?              @map("voice_context")
  /// The imported chat's last messages, both sides, oldest first: [{ "own": boolean, "text": string }].
  voiceHistory    Json                 @default("[]") @map("voice_history")
  /// When the team gave the chat back to the AI: their messages before it no longer keep it waiting.
  resumedAt       DateTime?            @map("resumed_at") @db.Timestamptz(6)
  /// default (the agency's), sales or natural (CHECK ai_chat_persona_value).
  persona         String               @default("default")
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  conversation    WhatsappConversation @relation(fields: [organizationId, conversationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, conversationId], map: "ai_chat_one_per_chat")
  @@index([organizationId, followUpAt], map: "ai_chat_follow_up")
  @@map("ai_chat")
}

/// A lesson learned from the agency's chats: what customers want, what wins a booking, an objection and its answer, how to
/// speak, a question asked often. General, never about one person. The owner turns each off or dismisses it.
model AiLearning {
  organizationId String       @default(dbgenerated("(NULLIF(current_setting('app.org_id'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  id             String       @id @default(uuid(7)) @db.Uuid
  /// need, winning, objection, style or faq (CHECK ai_learning_kind_value).
  kind           String
  text           String
  evidence       Int          @default(1)
  /// active, off or dismissed (CHECK ai_learning_state_value).
  state          String       @default("active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, state], map: "ai_learning_state")
  @@map("ai_learning")
}

/// A photo, video or PDF the autopilot may send in a chat (a brochure, a hotel's photos), with when it should. Its file is
/// an attachment of record type ai_media under the row's id. Soft-deleted.
model AiMedia {
  organizationId String       @default(dbgenerated("(NULLIF(current_setting('app.org_id'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  id             String       @id @default(uuid(7)) @db.Uuid
  title          String
  /// When the AI sends it, in the agency's words: "when they ask about Kashmir hotels".
  whenToSend     String       @default("") @map("when_to_send")
  attachmentId   String       @map("attachment_id") @db.Uuid
  fileName       String       @map("file_name")
  contentType    String       @map("content_type")
  /// Whether its upload finished: only a ready one is offered to the AI.
  ready          Boolean      @default(false)
  enabled        Boolean      @default(true)
  createdBy      String?      @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)
  deletedBy      String?      @map("deleted_by") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@map("ai_media")
}

/// A booking the autopilot took in a chat (the owner, 2026-10-29): the customer said yes, so the lead moved to Booking
/// requested, the payment details went out and the team was told; a photo or PDF the customer sends next is kept as their
/// payment proof (the chat's own message, whose file is already ours) for a person to check and confirm.
model AiBooking {
  organizationId  String       @default(dbgenerated("(NULLIF(current_setting('app.org_id'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  id              String       @id @default(uuid(7)) @db.Uuid
  leadId          String       @map("lead_id") @db.Uuid
  conversationId  String       @map("conversation_id") @db.Uuid
  /// What was booked, in a line: "Manali 5N for 4, 12 Dec, from Delhi".
  summary         String
  /// What the AI took down: package, dates, travellers' names, pickup city, amount (an object of strings).
  details         Json         @default("{}")
  /// awaiting_payment, proof_received, confirmed or cancelled (CHECK ai_booking_status_value).
  status          String       @default("awaiting_payment")
  /// The customer's messages (photos, PDFs) sent as proof of payment.
  proofMessageIds String[]     @default([]) @map("proof_message_ids") @db.Uuid
  decidedBy       String?      @map("decided_by") @db.Uuid
  decidedAt       DateTime?    @map("decided_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lead            Lead         @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, leadId], map: "ai_booking_by_lead")
  @@index([organizationId, conversationId], map: "ai_booking_by_chat")
  @@map("ai_booking")
}
